# Local-first mode. Transcript content stays on this machine.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_CONTEXT_WINDOW=16384

# Hosted competition preview. Set AI_PROVIDER=gemini and add a Google AI Studio key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Set to true only for UI rehearsal without an API key.
DEMO_MODE=false

PORT=8080
